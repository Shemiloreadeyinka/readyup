# ---------------------------------------------------------------------------
# CV Tailor - local backend configuration
# Copy this file to `.env` and fill in only what you need.
# Everything here is optional: the app runs with local Ollama out of the box.
# ---------------------------------------------------------------------------

# HTTP port for the local backend
PORT=8787

# Comma separated list of allowed origins. Chrome extension origins are
# allowed automatically; add http origins here only for local tooling.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Default AI provider used when the extension has not chosen one yet.
# One of: ollama | openai | anthropic
DEFAULT_AI_PROVIDER=ollama

# --- Local AI (no subscription required) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Cloud AI (optional). Keys live here, never in the extension. ----------
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Limits ----------------------------------------------------------------
# Max CV upload size in megabytes
MAX_UPLOAD_MB=8
# Max JSON request body size in megabytes
MAX_BODY_MB=2
# AI request timeout in milliseconds (local models can be slow)
AI_TIMEOUT_MS=180000

# --- Storage ---------------------------------------------------------------
# Directory used for the local JSON data store
DATA_DIR=./data

# Optional: restrict which Chrome extension ids may call this backend.
# Leave empty to accept any chrome-extension:// origin (fine for local dev).
ALLOWED_EXTENSION_IDS=
